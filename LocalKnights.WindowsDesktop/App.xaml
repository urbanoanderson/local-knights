<Application x:Class="LocalKnights.WindowsDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalKnights.WindowsDesktop"
             xmlns:views="clr-namespace:LocalKnights.WindowsDesktop.Views"
             xmlns:vm="clr-namespace:LocalKnights.WindowsDesktop.ViewModels"
             xmlns:converters="clr-namespace:LocalKnights.WindowsDesktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/LightTheme.xaml" />
                <ResourceDictionary Source="Styles/CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToInverseConverter x:Key="BooleanToInverseConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:DomainEnumStringConverter x:Key="DomainEnumStringConverter" />

            <DataTemplate DataType="{x:Type vm:StartViewModel}">
                <views:StartView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CreateClubViewModel}">
                <views:CreateClubView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ClubPreferencesViewModel}">
                <views:ClubPreferencesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlayersViewModel}">
                <views:PlayersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CreatePlayerViewModel}">
                <views:CreatePlayerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlayerViewModel}">
                <views:PlayerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GamesViewModel}">
                <views:GamesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GameViewModel}">
                <views:GameView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CreateGameViewModel}">
                <views:CreateGameView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CompetitionsViewModel}">
                <views:CompetitionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CreateCompetitionViewModel}">
                <views:CreateCompetitionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CompetitionViewModel}">
                <views:CompetitionView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
