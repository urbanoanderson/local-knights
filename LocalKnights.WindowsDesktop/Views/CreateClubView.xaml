<UserControl x:Class="LocalKnights.WindowsDesktop.Views.CreateClubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LocalKnights.WindowsDesktop.Views"
             xmlns:controls="clr-namespace:LocalKnights.WindowsDesktop.Controls"
            xmlns:models="clr-namespace:LocalKnights.Common.Models;assembly=LocalKnights.Common"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SideWidthStar}" />
            <ColumnDefinition Width="{StaticResource FormWidthStar}" />
            <ColumnDefinition Width="{StaticResource SideWidthStar}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreateClubTitle}" Style="{DynamicResource PageTitle}"
                   Margin="0,0,0,30" />

        <!-- Form -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
            <StackPanel>

                <!-- Required Fields -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,20">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding RequiredInformationHeader}" Style="{DynamicResource SectionTitle}"
                                   Margin="0,0,0,15" />

                        <StackPanel Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock Text="{Binding IdentifierNameLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding IdentifierName}" Style="{DynamicResource ModernTextBox}"
                                     ToolTip="{Binding CreateIdentifierNameTooltip}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding IdentifierNameHelp}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,0,15">
                            <TextBlock Text="{Binding DisplayNameLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding DisplayName}" Style="{DynamicResource ModernTextBox}"
                                     ToolTip="{Binding CreateDisplayNameTooltip}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding DisplayNameHelp}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,0,0,15">
                            <TextBlock Text="{Binding PasswordLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <PasswordBox Style="{DynamicResource ModernPasswordBox}"
                                         ToolTip="{Binding CreatePasswordTooltip}"
                                         Margin="0,0,0,5"
                                         PasswordChanged="PasswordBox_PasswordChanged" />
                            <TextBlock Text="{Binding PasswordHelp}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="{Binding ConfirmPasswordLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <PasswordBox Style="{DynamicResource ModernPasswordBox}"
                                         ToolTip="{Binding CreateConfirmPasswordTooltip}"
                                         Margin="0,0,0,5"
                                         PasswordChanged="ConfirmPasswordBox_PasswordChanged" />
                            <TextBlock Text="{Binding ConfirmPasswordHelp}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Rating Parameters -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,20">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding RatingParametersHeader}" Style="{DynamicResource SectionTitle}"
                                   Margin="0,0,0,15" />

                        <StackPanel Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock Text="{Binding RatingSystemLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <ComboBox SelectedValue="{Binding RatingSystem, Mode=TwoWay}" SelectedValuePath="Tag"
                                      Style="{DynamicResource ModernComboBox}"
                                      ToolTip="{Binding CreateRatingSystemTooltip}" Margin="0,0,0,5">
                                <ComboBoxItem Tag="{x:Static models:RatingSystem.Glicko2}">Glicko-2</ComboBoxItem>
                                <ComboBoxItem Tag="{x:Static models:RatingSystem.ELO}">ELO</ComboBoxItem>
                            </ComboBox>
                            <TextBlock Text="{Binding RatingSystemHelp}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,0,15">
                            <TextBlock Text="{Binding RatingLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <controls:CustomNumericUpDown Value="{Binding Rating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Minimum="{Binding MinRating}" Maximum="{Binding MaxRating}" Increment="50" DecimalPlaces="0"
                                                          Margin="0,0,0,5" ToolTip="{Binding CreateRatingTooltip}" />
                            <TextBlock Text="{Binding RatingHelp}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,0,0,15"
                                    Visibility="{Binding IsGlicko2Selected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding DeviationLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <controls:CustomNumericUpDown Value="{Binding Deviation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Minimum="150" Maximum="1000" Increment="10" DecimalPlaces="0"
                                                          Margin="0,0,0,5" ToolTip="{Binding CreateDeviationTooltip}" />
                            <TextBlock Text="{Binding DeviationHelp}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,0,0,15">
                            <TextBlock Text="{Binding MinRatingLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <controls:CustomNumericUpDown Value="{Binding MinRating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Minimum="100" Maximum="500" Increment="50" DecimalPlaces="0"
                                                          Margin="0,0,0,5" ToolTip="{Binding CreateMinRatingTooltip}" />
                        </StackPanel>

                        <StackPanel Grid.Row="5" Margin="0,0,0,15">
                            <TextBlock Text="{Binding MaxRatingLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <controls:CustomNumericUpDown Value="{Binding MaxRating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Minimum="3000" Maximum="4000" Increment="50" DecimalPlaces="0"
                                                          Margin="0,0,0,5" ToolTip="{Binding CreateMaxRatingTooltip}" />
                        </StackPanel>

                        <StackPanel Grid.Row="6" Margin="0,0,0,15"
                                    Visibility="{Binding IsGlicko2Selected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding VolatilityLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <controls:CustomNumericUpDown Value="{Binding Volatility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Minimum="0.01" Maximum="0.10" Increment="0.01" DecimalPlaces="2"
                                                          Margin="0,0,0,5" ToolTip="{Binding CreateVolatilityTooltip}" />
                            <TextBlock Text="{Binding VolatilityHelp}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="7" Margin="0,0,0,15"
                                    Visibility="{Binding IsEloSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ProvisionalGamesLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <controls:CustomNumericUpDown Value="{Binding ProvisionalGames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Minimum="0" Maximum="100" Increment="1" DecimalPlaces="0"
                                                          Margin="0,0,0,5" ToolTip="{Binding CreateProvisionalGamesTooltip}" />
                            <TextBlock Text="{Binding ProvisionalGamesHelp}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Optional Fields -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,20">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding OptionalInformationHeader}" Style="{DynamicResource SectionTitle}"
                                   Margin="0,0,0,15" />

                        <StackPanel Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock Text="{Binding DescriptionLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Description}" TextWrapping="Wrap" AcceptsReturn="True" Height="60"
                                     Style="{DynamicResource ModernTextBox}" ToolTip="{Binding CreateDescriptionTooltip}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding DescriptionHelp}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{Binding SocialMediaLinksLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox Text="{Binding NewSocialMediaLink}" Width="300" Style="{DynamicResource ModernTextBox}"
                                         ToolTip="{Binding CreateSocialMediaTooltip}" Margin="0,0,10,0"/>
                                <Button Content="{Binding AddButtonLabel}" Command="{Binding AddSocialMediaLinkCommand}"
                                        Style="{DynamicResource SecondaryButton}"/>
                            </StackPanel>
                            <ListBox x:Name="SocialMediaLinksListBox" ItemsSource="{Binding SocialMediaLinks}" Height="60"
                                     Style="{DynamicResource ModernListBox}" Margin="0,0,0,8"/>
                            <Button Content="{Binding RemoveSelectedLabel}" Command="{Binding RemoveSocialMediaLinkCommand}"
                                    CommandParameter="{Binding ElementName=SocialMediaLinksListBox, Path=SelectedItem}"
                                    Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SocialMediaHelp}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="{Binding CreateButtonLabel}" Command="{Binding CreateCommand}"
                    Style="{DynamicResource PrimaryButton}" Margin="0,0,20,0"/>
            <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"
                    Style="{DynamicResource SecondaryButton}"/>
        </StackPanel>

    </Grid>
</UserControl>