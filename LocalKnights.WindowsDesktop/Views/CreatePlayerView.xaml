<UserControl x:Class="LocalKnights.WindowsDesktop.Views.CreatePlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LocalKnights.WindowsDesktop.Converters"
             xmlns:controls="clr-namespace:LocalKnights.WindowsDesktop.Controls"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <converters:DomainEnumStringConverter x:Key="DomainEnumStringConverter" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SideWidthStar}" />
            <ColumnDefinition Width="{StaticResource FormWidthStar}" />
            <ColumnDefinition Width="{StaticResource SideWidthStar}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreatePlayer}" Style="{DynamicResource PageTitle}"
               Margin="0,0,0,30" />

        <!-- Form -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
            <StackPanel>

                <!-- Required Section -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,20">
                    <StackPanel Margin="20">
                        <TextBlock Text="{Binding RequiredFields}" Style="{DynamicResource SectionTitle}" Margin="0,0,0,15" />

                        <!-- Identifier Name -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding IdentifierNameLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding IdentifierName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}" ToolTip="{Binding CreateIdentifierNameTooltip}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding LowercaseLettersNumbersMaxHelpText}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <!-- Display Name -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding DisplayNameLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}" ToolTip="{Binding CreateDisplayNameTooltip}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Max100CharactersHelpText}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- ================= -->
                <!-- Optional Sections -->
                <!-- ================= -->

                <!-- Ratings Section -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,20">
                    <StackPanel Margin="20">
                        <TextBlock Text="{Binding RatingsDescription}" Style="{DynamicResource SectionTitle}" Margin="0,0,0,15" />

                        <!-- Bullet Rating -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding BulletRatingLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding RatingLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <controls:CustomNumericUpDown Grid.Column="1" Value="{Binding BulletRating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Minimum="{Binding RatingLowerBound}" Maximum="{Binding RatingUpperBound}" Increment="1" DecimalPlaces="0" />
                                <TextBlock Grid.Column="3" Text="{Binding DeviationLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Grid.Column="4" Text="{Binding BulletDeviationText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"
                                         Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </StackPanel>

                        <!-- Blitz Rating -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding BlitzRatingLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding RatingLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <controls:CustomNumericUpDown Grid.Column="1" Value="{Binding BlitzRating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Minimum="{Binding RatingLowerBound}" Maximum="{Binding RatingUpperBound}" Increment="1" DecimalPlaces="0" />
                                <TextBlock Grid.Column="3" Text="{Binding DeviationLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Grid.Column="4" Text="{Binding BlitzDeviationText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"
                                         Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </StackPanel>

                        <!-- Rapid Rating -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding RapidRatingLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding RatingLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <controls:CustomNumericUpDown Grid.Column="1" Value="{Binding RapidRating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Minimum="{Binding RatingLowerBound}" Maximum="{Binding RatingUpperBound}" Increment="1" DecimalPlaces="0" />
                                <TextBlock Grid.Column="3" Text="{Binding DeviationLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Grid.Column="4" Text="{Binding RapidDeviationText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"
                                         Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </StackPanel>

                        <!-- Classical Rating -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding ClassicalRatingLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding RatingLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <controls:CustomNumericUpDown Grid.Column="1" Value="{Binding ClassicalRating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Minimum="{Binding RatingLowerBound}" Maximum="{Binding RatingUpperBound}" Increment="1" DecimalPlaces="0" />
                                <TextBlock Grid.Column="3" Text="{Binding DeviationLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Grid.Column="4" Text="{Binding ClassicalDeviationText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"
                                         Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </StackPanel>

                        <!-- Chess Title -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding ChessTitleLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ChessTitles}" SelectedItem="{Binding SelectedChessTitle}"
                                          Style="{DynamicResource ModernComboBox}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource DomainEnumStringConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- External Profiles Section -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,20">
                    <StackPanel Margin="20">

                        <TextBlock Text="{Binding ExternalProfilesLabel}" Style="{DynamicResource SectionTitle}" Margin="0,0,0,15" />

                        <!-- Chess.com Username -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding ChessComUsernameLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding ChessComUsername, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"/>
                                <Button Grid.Column="2"
                                        Content="{Binding FetchRatingsLabel}"
                                        Command="{Binding FetchChessComRatingsCommand}"
                                        Style="{DynamicResource SecondaryButton}"
                                        MinWidth="130"/>
                            </Grid>
                            <TextBlock Text="{Binding Max50CharactersHelpText}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <!-- Lichess Username -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding LichessUsernameLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding LichessUsername, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"/>
                                <Button Grid.Column="2"
                                        Content="{Binding FetchRatingsLabel}"
                                        Command="{Binding FetchLichessRatingsCommand}"
                                        Style="{DynamicResource SecondaryButton}"
                                        MinWidth="130"/>
                            </Grid>
                            <TextBlock Text="{Binding Max50CharactersHelpText}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <!-- FIDE ID -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding FideIdLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding FideId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"/>
                                <Button Grid.Column="2"
                                        Content="{Binding FetchRatingsLabel}"
                                        Command="{Binding FetchFideRatingsCommand}"
                                        Style="{DynamicResource SecondaryButton}"
                                        MinWidth="130"/>
                            </Grid>
                            <TextBlock Text="{Binding NumericMax12CharactersHelpText}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <!-- USCF ID -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding UscfIdLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding UscfId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding NumericMax12CharactersHelpText}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <!-- CBX ID -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding CbxIdLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding CbxId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding NumericMax12CharactersHelpText}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Contact Information Section -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,20">
                    <StackPanel Margin="20">

                        <TextBlock Text="{Binding ContactInformationSection}" Style="{DynamicResource SectionTitle}" Margin="0,0,0,15" />

                        <!-- Email -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding EmailLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Max100CharactersHelpText}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <!-- Phone -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding PhoneLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Max20CharactersHelpText}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                        <!-- Birth Date -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="{Binding BirthDateLabel}" Style="{DynamicResource LabelText}" Margin="0,0,0,8"/>
                            <DatePicker SelectedDate="{Binding BirthDate, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ModernDatePicker}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding BirthDateHelp}" Style="{DynamicResource HelpText}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="{Binding CreateButtonLabel}" Command="{Binding CreateCommand}"
                    Style="{DynamicResource PrimaryButton}" Margin="0,0,20,0"/>
            <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"
                    Style="{DynamicResource SecondaryButton}"/>
        </StackPanel>

    </Grid>
</UserControl>
