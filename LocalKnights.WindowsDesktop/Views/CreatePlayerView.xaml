<UserControl x:Class="LocalKnights.WindowsDesktop.Views.CreatePlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LocalKnights.WindowsDesktop.Converters"
             xmlns:controls="clr-namespace:LocalKnights.WindowsDesktop.Controls"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <converters:DomainEnumStringConverter x:Key="DomainEnumStringConverter" />
    </UserControl.Resources>
    <Grid Margin="{StaticResource SpacingExtraLarge}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SideWidthStar}" />
            <ColumnDefinition Width="{StaticResource FormWidthStar}" />
            <ColumnDefinition Width="{StaticResource SideWidthStar}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreatePlayer}" Style="{DynamicResource PageTitle}"
               Margin="{StaticResource PageHeaderBottomSpacing}" />

        <!-- Form -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="{StaticResource SpacingExtraLargeRight}">
            <StackPanel>

                <!-- Required Section -->
                <Border Style="{DynamicResource Card}" Margin="{StaticResource SpacingExtraLargeBottom}">
                    <StackPanel Margin="{StaticResource SpacingExtraLarge}">
                        <TextBlock Text="{Binding RequiredFields}" Style="{DynamicResource SectionTitle}" Margin="{StaticResource SpacingSectionBottom}" />

                        <!-- Identifier Name -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding IdentifierNameLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <TextBox Text="{Binding IdentifierName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}" ToolTip="{Binding CreatePlayerIdentifierHelp}" Margin="{StaticResource SpacingSmallBottom}"/>
                            <TextBlock Text="{Binding CreatePlayerIdentifierHelp}" Style="{DynamicResource HelpText}" ToolTip="{Binding CreatePlayerIdentifierHelp}"/>
                        </StackPanel>

                        <!-- Display Name -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding DisplayNameLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}" ToolTip="{Binding PlayerDisplayNameHelp}" Margin="{StaticResource SpacingSmallBottom}"/>
                            <TextBlock Text="{Binding PlayerDisplayNameHelp}" Style="{DynamicResource HelpText}" ToolTip="{Binding PlayerDisplayNameHelp}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- ================= -->
                <!-- Optional Sections -->
                <!-- ================= -->

                <!-- Ratings Section -->
                <Border Style="{DynamicResource Card}" Margin="{StaticResource SpacingExtraLargeBottom}">
                    <StackPanel Margin="{StaticResource SpacingExtraLarge}">
                        <TextBlock Text="{Binding RatingsDescription}" Style="{DynamicResource SectionTitle}" Margin="{StaticResource SpacingSectionBottom}" />

                        <!-- Bullet Rating -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding BulletRatingLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding RatingLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="{StaticResource SpacingMediumRight}" Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <controls:CustomNumericUpDown Grid.Column="1" Value="{Binding BulletRating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Minimum="{Binding RatingLowerBound}" Maximum="{Binding RatingUpperBound}" Increment="1" DecimalPlaces="0" ToolTip="{Binding BulletRatingHelp}" />
                                <TextBlock Grid.Column="3" Text="{Binding DeviationLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="{StaticResource SpacingMediumRight}" Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Grid.Column="4" Text="{Binding BulletDeviationText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}" ToolTip="{Binding BulletDeviationHelp}"
                                         Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </StackPanel>

                        <!-- Blitz Rating -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding BlitzRatingLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding RatingLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="{StaticResource SpacingMediumRight}"
                                           Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <controls:CustomNumericUpDown Grid.Column="1" Value="{Binding BlitzRating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Minimum="{Binding RatingLowerBound}" Maximum="{Binding RatingUpperBound}" Increment="1" DecimalPlaces="0" ToolTip="{Binding BlitzRatingHelp}" />
                                <TextBlock Grid.Column="3" Text="{Binding DeviationLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="{StaticResource SpacingMediumRight}"
                                           Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Grid.Column="4" Text="{Binding BlitzDeviationText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}" ToolTip="{Binding BlitzDeviationHelp}"
                                         Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </StackPanel>

                        <!-- Rapid Rating -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding RapidRatingLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding RatingLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="{StaticResource SpacingMediumRight}"
                                           Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <controls:CustomNumericUpDown Grid.Column="1" Value="{Binding RapidRating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Minimum="{Binding RatingLowerBound}" Maximum="{Binding RatingUpperBound}" Increment="1" DecimalPlaces="0" ToolTip="{Binding RapidRatingHelp}" />
                                <TextBlock Grid.Column="3" Text="{Binding DeviationLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="{StaticResource SpacingMediumRight}"
                                           Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Grid.Column="4" Text="{Binding RapidDeviationText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}" ToolTip="{Binding RapidDeviationHelp}"
                                         Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </StackPanel>

                        <!-- Classical Rating -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding ClassicalRatingLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding RatingLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="{StaticResource SpacingMediumRight}"
                                           Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <controls:CustomNumericUpDown Grid.Column="1" Value="{Binding ClassicalRating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Minimum="{Binding RatingLowerBound}" Maximum="{Binding RatingUpperBound}" Increment="1" DecimalPlaces="0" ToolTip="{Binding ClassicalRatingHelp}" />
                                <TextBlock Grid.Column="3" Text="{Binding DeviationLabel}" Style="{DynamicResource LabelText}" VerticalAlignment="Center" Margin="{StaticResource SpacingMediumRight}"
                                           Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Grid.Column="4" Text="{Binding ClassicalDeviationText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}" ToolTip="{Binding ClassicalDeviationHelp}"
                                         Visibility="{Binding IsDeviationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </StackPanel>

                        <!-- Chess Title -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding ChessTitleLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ChessTitles}" SelectedItem="{Binding SelectedChessTitle}"
                                          Style="{DynamicResource ModernComboBox}" ToolTip="{Binding PlayerChessTitleHelp}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource DomainEnumStringConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="{Binding PlayerChessTitleHelp}" Style="{DynamicResource HelpText}" ToolTip="{Binding PlayerChessTitleHelp}" />
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- External Profiles Section -->
                <Border Style="{DynamicResource Card}" Margin="{StaticResource SpacingExtraLargeBottom}">
                    <StackPanel Margin="{StaticResource SpacingExtraLarge}">

                        <TextBlock Text="{Binding ExternalProfilesLabel}" Style="{DynamicResource SectionTitle}" Margin="{StaticResource SpacingSectionBottom}" />

                        <!-- Chess.com Username -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding ChessComUsernameLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <Grid Margin="{StaticResource SpacingSmallBottom}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding ChessComUsername, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}" ToolTip="{Binding CreatePlayerChessComUsernameTooltip}"/>
                                <Button Grid.Column="2"
                                        Content="{Binding FetchRatingsLabel}"
                                        Command="{Binding FetchChessComRatingsCommand}"
                                        Style="{DynamicResource SecondaryButton}"
                                        MinWidth="130"/>
                            </Grid>
                            <TextBlock Text="{Binding CreatePlayerChessComUsernameHelp}" Style="{DynamicResource HelpText}" ToolTip="{Binding CreatePlayerChessComUsernameTooltip}"/>
                        </StackPanel>

                        <!-- Lichess Username -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding LichessUsernameLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <Grid Margin="{StaticResource SpacingSmallBottom}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding LichessUsername, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}" ToolTip="{Binding CreatePlayerLichessUsernameTooltip}"/>
                                <Button Grid.Column="2"
                                        Content="{Binding FetchRatingsLabel}"
                                        Command="{Binding FetchLichessRatingsCommand}"
                                        Style="{DynamicResource SecondaryButton}"
                                        MinWidth="130"/>
                            </Grid>
                            <TextBlock Text="{Binding CreatePlayerLichessUsernameHelp}" Style="{DynamicResource HelpText}" ToolTip="{Binding CreatePlayerLichessUsernameTooltip}"/>
                        </StackPanel>

                        <!-- FIDE ID -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding FideIdLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <Grid Margin="{StaticResource SpacingSmallBottom}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding FideId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}" ToolTip="{Binding CreatePlayerFideIdTooltip}"/>
                                <Button Grid.Column="2"
                                        Content="{Binding FetchRatingsLabel}"
                                        Command="{Binding FetchFideRatingsCommand}"
                                        Style="{DynamicResource SecondaryButton}"
                                        MinWidth="130"/>
                            </Grid>
                            <TextBlock Text="{Binding CreatePlayerFideIdHelp}" Style="{DynamicResource HelpText}" ToolTip="{Binding CreatePlayerFideIdTooltip}"/>
                        </StackPanel>

                        <!-- USCF ID -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding UscfIdLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <TextBox Text="{Binding UscfId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}" ToolTip="{Binding PlayerUscfIdHelp}" Margin="{StaticResource SpacingSmallBottom}"/>
                            <TextBlock Text="{Binding PlayerUscfIdHelp}" Style="{DynamicResource HelpText}" ToolTip="{Binding PlayerUscfIdHelp}"/>
                        </StackPanel>

                        <!-- CBX ID -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding CbxIdLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <TextBox Text="{Binding CbxId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}" ToolTip="{Binding PlayerCbxIdHelp}" Margin="{StaticResource SpacingSmallBottom}"/>
                            <TextBlock Text="{Binding PlayerCbxIdHelp}" Style="{DynamicResource HelpText}" ToolTip="{Binding PlayerCbxIdHelp}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Contact Information Section -->
                <Border Style="{DynamicResource Card}" Margin="{StaticResource SpacingExtraLargeBottom}">
                    <StackPanel Margin="{StaticResource SpacingExtraLarge}">

                        <TextBlock Text="{Binding ContactInformationSection}" Style="{DynamicResource SectionTitle}" Margin="{StaticResource SpacingSectionBottom}" />

                        <!-- Email -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding EmailLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}" ToolTip="{Binding PlayerEmailHelp}" Margin="{StaticResource SpacingSmallBottom}"/>
                            <TextBlock Text="{Binding PlayerEmailHelp}" Style="{DynamicResource HelpText}" ToolTip="{Binding PlayerEmailHelp}"/>
                        </StackPanel>

                        <!-- Phone -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding PhoneLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}" ToolTip="{Binding PlayerPhoneHelp}" Margin="{StaticResource SpacingSmallBottom}"/>
                            <TextBlock Text="{Binding PlayerPhoneHelp}" Style="{DynamicResource HelpText}" ToolTip="{Binding PlayerPhoneHelp}"/>
                        </StackPanel>

                        <!-- Birth Date -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding BirthDateLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <DatePicker SelectedDate="{Binding BirthDate, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ModernDatePicker}" ToolTip="{Binding PlayerBirthDateHelp}" Margin="{StaticResource SpacingSmallBottom}"/>
                            <TextBlock Text="{Binding PlayerBirthDateHelp}" Style="{DynamicResource HelpText}" ToolTip="{Binding PlayerBirthDateHelp}"/>
                        </StackPanel>

                        <!-- Gender -->
                        <StackPanel Margin="{StaticResource SpacingSectionBottom}">
                            <TextBlock Text="{Binding GenderLabel}" Style="{DynamicResource LabelText}" Margin="{StaticResource SpacingMediumBottom}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding GenderTypes}" SelectedItem="{Binding SelectedGender}"
                                          Style="{DynamicResource ModernComboBox}" ToolTip="{Binding PlayerGenderHelp}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource DomainEnumStringConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="{Binding PlayerGenderHelp}" Style="{DynamicResource HelpText}" ToolTip="{Binding PlayerGenderHelp}" />
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource ActionRowTopSpacing}">
            <Button Content="{Binding CreateButtonLabel}" Command="{Binding CreateCommand}"
                    Style="{DynamicResource PrimaryButton}" Margin="{StaticResource SpacingExtraLargeRight}"/>
            <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"
                    Style="{DynamicResource SecondaryButton}"/>
        </StackPanel>

    </Grid>
</UserControl>
