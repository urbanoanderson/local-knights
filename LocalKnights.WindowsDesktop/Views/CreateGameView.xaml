<UserControl x:Class="LocalKnights.WindowsDesktop.Views.CreateGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="{StaticResource SpacingExtraLarge}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SideWidthStar}" />
            <ColumnDefinition Width="{StaticResource FormWidthStar}" />
            <ColumnDefinition Width="{StaticResource SideWidthStar}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreateGame}" Style="{DynamicResource PageTitle}" Margin="{StaticResource SpacingExtraLargeBottom}"/>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="{StaticResource SpacingExtraLargeRight}">
            <StackPanel>
                <Border Style="{DynamicResource Card}" Margin="{StaticResource SpacingExtraLargeBottom}">
                    <StackPanel Margin="{StaticResource SpacingExtraLarge}">
                        <TextBlock Text="{Binding ParticipantsLabel}" Style="{DynamicResource SectionTitle}" Margin="{StaticResource SpacingLargeBottom}" />

                        <TextBlock Text="{Binding WhitePlayerLabel}" Style="{DynamicResource LabelText}" />
                        <TextBox Text="{Binding WhitePlayerQuery, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="WhitePlayerSearchBox"
                                 Style="{DynamicResource ModernAutoSuggestInput}"
                                 Tag="{Binding SearchPlaceholder}"
                                 ToolTip="{Binding SearchPlaceholder}"
                                 GotFocus="WhitePlayerSearchBox_GotFocus"
                                 LostFocus="WhitePlayerSearchBox_LostFocus"
                                 Margin="{StaticResource SpacingMediumBottom}" />

                        <Border x:Name="WhiteSuggestionsContainer" Margin="{StaticResource SpacingLargeBottom}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SuggestionListContainer}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowWhiteSuggestions}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ListBox ItemsSource="{Binding WhiteSuggestions}" Style="{DynamicResource ModernSuggestionList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding DataContext.SelectWhiteSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource SuggestionItemButton}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border x:Name="WhiteSelectedPlayerContainer" Margin="{StaticResource SpacingLargeBottom}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SelectedParticipantContainer}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWhitePlayerSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SelectedWhitePlayerDisplay}" Style="{DynamicResource LabelText}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="{Binding RemoveParticipantButtonLabel}"
                                        Command="{Binding RemoveWhitePlayerCommand}"
                                        Style="{DynamicResource SecondaryButton}"
                                        Margin="{StaticResource SpacingLargeLeft}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding BlackPlayerLabel}" Style="{DynamicResource LabelText}" />
                        <TextBox Text="{Binding BlackPlayerQuery, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="BlackPlayerSearchBox"
                                 Style="{DynamicResource ModernAutoSuggestInput}"
                                 Tag="{Binding SearchPlaceholder}"
                                 ToolTip="{Binding SearchPlaceholder}"
                                 GotFocus="BlackPlayerSearchBox_GotFocus"
                                 LostFocus="BlackPlayerSearchBox_LostFocus"
                                 Margin="{StaticResource SpacingMediumBottom}" />

                        <Border x:Name="BlackSuggestionsContainer" Margin="{StaticResource SpacingLargeBottom}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SuggestionListContainer}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowBlackSuggestions}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ListBox ItemsSource="{Binding BlackSuggestions}" Style="{DynamicResource ModernSuggestionList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding DataContext.SelectBlackSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource SuggestionItemButton}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border Margin="{StaticResource SpacingLargeBottom}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SelectedParticipantContainer}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBlackPlayerSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SelectedBlackPlayerDisplay}" Style="{DynamicResource LabelText}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="{Binding RemoveParticipantButtonLabel}"
                                        Command="{Binding RemoveBlackPlayerCommand}"
                                        Style="{DynamicResource SecondaryButton}"
                                        Margin="{StaticResource SpacingLargeLeft}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding TimeFormatLabel}" Style="{DynamicResource LabelText}" />
                        <ComboBox ItemsSource="{Binding TimeFormats}"
                                  SelectedItem="{Binding SelectedTimeFormat}"
                                  Style="{DynamicResource ModernComboBox}"
                                  Margin="{StaticResource SpacingLargeBottom}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource DomainEnumStringConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding ResultLabel}" Style="{DynamicResource LabelText}" />
                        <ComboBox ItemsSource="{Binding Results}"
                                  SelectedItem="{Binding SelectedResult}"
                                  Style="{DynamicResource ModernComboBox}"
                                  Margin="{StaticResource SpacingLargeBottom}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource DomainEnumStringConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding RatedLabel}" Style="{DynamicResource LabelText}" />
                        <CheckBox IsChecked="{Binding IsRated}" Style="{DynamicResource ModernCheckBox}" Margin="{StaticResource SpacingLargeBottom}" />

                        <TextBlock Text="{Binding PgnLabel}" Style="{DynamicResource LabelText}" />
                        <TextBox Text="{Binding Pgn, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="220" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="{Binding CreateButtonLabel}" Command="{Binding CreateCommand}" Style="{DynamicResource PrimaryButton}" Margin="{StaticResource SpacingLargeRight}"/>
            <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Style="{DynamicResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
