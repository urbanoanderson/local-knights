<UserControl x:Class="LocalKnights.WindowsDesktop.Views.CompetitionsView"
             x:Name="CompetitionRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LocalKnights.WindowsDesktop.Views"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding CompetitionsPage}"
                   Style="{DynamicResource PageTitle}" />

        <TextBox Grid.Row="1"
                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                 Padding="12"
                 Margin="0,0,0,16"
                 FontSize="13"
                 Background="{DynamicResource BackgroundBrush}"
                 Foreground="{DynamicResource ForegroundBrush}"
                 CaretBrush="{DynamicResource ForegroundBrush}"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource BorderBrush}">
            <TextBox.Template>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Grid>
                            <TextBlock IsHitTestVisible="False"
                                       Text="{Binding CompetitionsSearchPlaceholder}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Padding="12,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Margin="0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </TextBox.Template>
        </TextBox>

        <DataGrid x:Name="CompetitionsDataGrid" Grid.Row="2"
                  ItemsSource="{Binding Competitions}"
                  Style="{DynamicResource ModernDataGrid}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  Margin="0,0,0,16"
                  Sorting="CompetitionsDataGrid_Sorting"
                  MouseDoubleClick="CompetitionsDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Width="70" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="{DynamicResource LinkBrush}"/>
                            <Setter Property="TextDecorations" Value="Underline"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding CreatedAt}" Width="170" />
                <DataGridTextColumn Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Binding="{Binding Type}" Width="120" />
                <DataGridTextColumn Binding="{Binding TimeFormat}" Width="120" />
                <DataGridTextColumn Binding="{Binding Rated}" Width="90" />
                <DataGridTextColumn Binding="{Binding State}" Width="110" />
                <DataGridTextColumn Binding="{Binding Winner}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{Binding BackButtonLabel}"
                    Command="{Binding BackCommand}"
                        Style="{DynamicResource SecondaryButton}" />
                <Button Content="{Binding CreateButtonLabel}"
                        Command="{Binding CreateCompetitionCommand}"
                        Style="{DynamicResource PrimaryButton}"
                        Margin="12,0,0,0" />
            </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Content="{Binding PreviousPageButtonLabel}"
                    Command="{Binding PreviousPageCommand}"
                    Style="{DynamicResource SecondaryButton}" />
                <TextBlock Text="{Binding CurrentPageDisplay}"
                       Style="{DynamicResource LabelText}"
                       VerticalAlignment="Center"
                       Margin="12,0" />
                <Button Content="{Binding NextPageButtonLabel}"
                    Command="{Binding NextPageCommand}"
                    Style="{DynamicResource SecondaryButton}" />
                </StackPanel>
        </Grid>
    </Grid>
</UserControl>