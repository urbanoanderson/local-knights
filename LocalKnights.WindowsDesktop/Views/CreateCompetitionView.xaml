<UserControl x:Class="LocalKnights.WindowsDesktop.Views.CreateCompetitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalKnights.WindowsDesktop.Views"
             xmlns:controls="clr-namespace:LocalKnights.WindowsDesktop.Controls"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="{StaticResource SpacingExtraLarge}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SideWidthStar}" />
            <ColumnDefinition Width="{StaticResource FormWidthStar}" />
            <ColumnDefinition Width="{StaticResource SideWidthStar}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="1"
                   Text="{Binding CreateCompetition}"
                   Style="{DynamicResource PageTitle}" />

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="{StaticResource SpacingExtraLargeRight}">
            <StackPanel>
                <Border Style="{DynamicResource Card}">
                    <StackPanel Margin="{StaticResource SpacingExtraLarge}">
                        <TextBlock Text="{Binding TitleLabel}" Style="{DynamicResource LabelText}" />
                        <TextBox Text="{Binding Title}" Style="{DynamicResource ModernTextBox}" Margin="{StaticResource SpacingLargeBottom}" />

                        <TextBlock Text="{Binding DescriptionLabel}" Style="{DynamicResource LabelText}" />
                        <TextBox Text="{Binding Description}" Style="{DynamicResource ModernTextBox}" Margin="{StaticResource SpacingLargeBottom}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />

                        <TextBlock Text="{Binding CityLabel}" Style="{DynamicResource LabelText}" />
                        <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" ToolTip="{Binding CityTooltip}" Style="{DynamicResource ModernTextBox}" Margin="{StaticResource SpacingLargeBottom}" />

                        <TextBlock Text="{Binding ChiefArbiterLabel}" Style="{DynamicResource LabelText}" />
                        <TextBox Text="{Binding ChiefArbiter, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" ToolTip="{Binding ChiefArbiterTooltip}" Style="{DynamicResource ModernTextBox}" Margin="{StaticResource SpacingLargeBottom}" />

                        <TextBlock Text="{Binding FederationLabel}" Style="{DynamicResource LabelText}" />
                        <TextBox Text="{Binding Federation, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" CharacterCasing="Upper" ToolTip="{Binding FederationTooltip}" Style="{DynamicResource ModernTextBox}" Margin="{StaticResource SpacingLargeBottom}" />

                        <TextBlock Text="{Binding TimeFormatLabel}" Style="{DynamicResource LabelText}" />
                        <ComboBox ItemsSource="{Binding TimeFormatOptions}"
                                  SelectedItem="{Binding TimeFormat}"
                                  Style="{DynamicResource ModernComboBox}" Margin="{StaticResource SpacingLargeBottom}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource DomainEnumStringConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding RatedLabel}" Style="{DynamicResource LabelText}" />
                        <CheckBox IsChecked="{Binding IsRated}" Style="{DynamicResource ModernCheckBox}" Margin="{StaticResource SpacingLargeBottom}" />

                        <TextBlock Text="{Binding TypeLabel}" Style="{DynamicResource LabelText}" />
                        <ComboBox ItemsSource="{Binding CompetitionTypeOptions}"
                                  SelectedItem="{Binding Type}"
                                  Style="{DynamicResource ModernComboBox}" Margin="{StaticResource SpacingLargeBottom}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource DomainEnumStringConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Visibility="{Binding IsNumberOfRoundsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding NumberOfRoundsLabel}" Style="{DynamicResource LabelText}" />
                            <controls:CustomNumericUpDown Value="{Binding NumberOfRounds}" Minimum="1" Maximum="30" Margin="{StaticResource SpacingLargeBottom}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsDoubleRoundRobinVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding DoubleRoundRobinLabel}" Style="{DynamicResource LabelText}" />
                            <CheckBox IsChecked="{Binding IsDoubleRoundRobin}" Style="{DynamicResource ModernCheckBox}" Margin="{StaticResource SpacingLargeBottom}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsByeValueVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ByeValueLabel}" Style="{DynamicResource LabelText}" />
                            <ComboBox ItemsSource="{Binding ByeValues}" SelectedItem="{Binding ByeValue}" Style="{DynamicResource ModernComboBox}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource ActionRowTopSpacing}">
            <Button Content="{Binding CreateButtonLabel}" Command="{Binding CreateCommand}" Style="{DynamicResource PrimaryButton}" Margin="{StaticResource SpacingLargeRight}" />
            <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Style="{DynamicResource SecondaryButton}" />
        </StackPanel>
    </Grid>
</UserControl>