<Window x:Class="LocalKnights.WindowsDesktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocalKnights.WindowsDesktop"
        xmlns:vm="clr-namespace:LocalKnights.WindowsDesktop.ViewModels"
        xmlns:helpers="clr-namespace:LocalKnights.WindowsDesktop.Helpers"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="720" Width="1280"
        Icon="/Resources/Icon/logo-bg.png"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <DockPanel Background="{DynamicResource WindowBackgroundBrush}">
        <Menu DockPanel.Dock="Top" Style="{DynamicResource ModernMenu}">
            <MenuItem Header="{Binding ClubMenu}" Style="{DynamicResource ModernMenuItem}">
                <MenuItem Header="{Binding SignOut}" Command="{Binding SignOutCommand}" Style="{DynamicResource ModernMenuItem}" />
                <MenuItem Header="{Binding ClubDashboard}" Command="{Binding ClubDashboardCommand}" Style="{DynamicResource ModernMenuItem}" />
                <MenuItem Header="{Binding OpenDatabaseLocation}" Command="{Binding OpenDatabaseLocationCommand}" Style="{DynamicResource ModernMenuItem}" />
                <MenuItem Header="{Binding Exit}" Command="{Binding ExitCommand}" Style="{DynamicResource ModernMenuItem}" />
            </MenuItem>
            <MenuItem Header="{Binding OptionsMenu}" Style="{DynamicResource ModernMenuItem}">
                <MenuItem Header="{Binding DarkMode}" IsCheckable="true" IsChecked="{Binding IsDarkMode, Mode=TwoWay}" Style="{DynamicResource ModernMenuItem}" />
                <MenuItem Header="{Binding ChooseLanguage}" Style="{DynamicResource ModernMenuItem}">
                    <MenuItem Header="{Binding English}"
                              Command="{Binding SwitchToEnglishCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsEnglishSelected, Mode=OneWay}"
                              Style="{DynamicResource ModernMenuItem}">
                        <MenuItem.Icon>
                            <TextBlock Text="{Binding EnglishFlag}" FontSize="{StaticResource FontSizeBody}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding Portuguese}"
                              Command="{Binding SwitchToPortugueseCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsPortugueseSelected, Mode=OneWay}"
                              Style="{DynamicResource ModernMenuItem}">
                        <MenuItem.Icon>
                            <TextBlock Text="{Binding PortugueseFlag}" FontSize="{StaticResource FontSizeBody}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding Spanish}"
                              Command="{Binding SwitchToSpanishCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsSpanishSelected, Mode=OneWay}"
                              Style="{DynamicResource ModernMenuItem}">
                        <MenuItem.Icon>
                            <TextBlock Text="{Binding SpanishFlag}" FontSize="{StaticResource FontSizeBody}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding French}"
                              Command="{Binding SwitchToFrenchCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsFrenchSelected, Mode=OneWay}"
                              Style="{DynamicResource ModernMenuItem}">
                        <MenuItem.Icon>
                            <TextBlock Text="{Binding FrenchFlag}" FontSize="{StaticResource FontSizeBody}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding German}"
                              Command="{Binding SwitchToGermanCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsGermanSelected, Mode=OneWay}"
                              Style="{DynamicResource ModernMenuItem}">
                        <MenuItem.Icon>
                            <TextBlock Text="{Binding GermanFlag}" FontSize="{StaticResource FontSizeBody}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding Russian}"
                              Command="{Binding SwitchToRussianCommand}"
                              IsCheckable="True"
                              IsChecked="{Binding IsRussianSelected, Mode=OneWay}"
                              Style="{DynamicResource ModernMenuItem}">
                        <MenuItem.Icon>
                            <TextBlock Text="{Binding RussianFlag}" FontSize="{StaticResource FontSizeBody}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                 <!-- <Separator /> -->
                <MenuItem Header="{Binding ItemsPerPage}" Style="{DynamicResource ModernMenuItem}">
                    <MenuItem Header="{Binding PageSize10}"
                              Command="{Binding SetPageSize10Command}"
                              IsCheckable="True"
                              IsChecked="{Binding IsPageSize10Selected, Mode=OneWay}"
                              Style="{DynamicResource ModernMenuItem}" />
                    <MenuItem Header="{Binding PageSize50}"
                              Command="{Binding SetPageSize50Command}"
                              IsCheckable="True"
                              IsChecked="{Binding IsPageSize50Selected, Mode=OneWay}"
                              Style="{DynamicResource ModernMenuItem}" />
                    <MenuItem Header="{Binding PageSize100}"
                              Command="{Binding SetPageSize100Command}"
                              IsCheckable="True"
                              IsChecked="{Binding IsPageSize100Selected, Mode=OneWay}"
                              Style="{DynamicResource ModernMenuItem}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{Binding HelpMenu}" Style="{DynamicResource ModernMenuItem}">
                <MenuItem Header="{Binding ProjectPage}" Command="{Binding ProjectPageCommand}" Style="{DynamicResource ModernMenuItem}" />
                <MenuItem Header="{Binding About}" Command="{Binding AboutCommand}" Style="{DynamicResource ModernMenuItem}" />
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom" Style="{DynamicResource ModernStatusBar}">
            <StatusBarItem>
                <TextBlock Text="{Binding Source={x:Static helpers:AppConstants.AppDisplayName}, StringFormat='© 2026 {0}'}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="💽"
                           Opacity="1"
                           Visibility="{Binding ShowDataAccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="TextBlock.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1"
                                                     To="0.0"
                                                     Duration="{StaticResource StatusPulseDuration}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
        <ContentControl Content="{Binding CurrentViewModel}" Background="{DynamicResource WindowBackgroundBrush}" />
    </DockPanel>
</Window>
