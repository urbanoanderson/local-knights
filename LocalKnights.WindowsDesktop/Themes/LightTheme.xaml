<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#222222" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#444444" />
    <!-- Foreground color for disabled/read-only controls -->
    <SolidColorBrush x:Key="ControlDisabledForegroundBrush" Color="#6B6B6B" />
    <!-- Scrollbar thumb colors -->
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#B0B0B0" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#007BFF" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#007BFF" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0056B3" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#004085" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#555555" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#28A745" />
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#218838" />
    <SolidColorBrush x:Key="SuccessPressedBrush" Color="#1E7E34" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC3545" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#C82333" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#BD2130" />
    <SolidColorBrush x:Key="WarningBrush" Color="#CF9C06" />
    <SolidColorBrush x:Key="WarningHoverBrush" Color="#E8B006" />
    <SolidColorBrush x:Key="WarningPressedBrush" Color="#AB8204" />
    <SolidColorBrush x:Key="InfoBrush" Color="#17A2B8" />
    <SolidColorBrush x:Key="LinkBrush" Color="#007BFF" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#555555" />
    <SolidColorBrush x:Key="MenuHighlightBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#000000" Opacity="0.1" />
    <SolidColorBrush x:Key="DataGridHeaderRowBackgroundBrush" Color="#BBBBBB" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="DataGridRowHoverBackgroundBrush" Color="#AAAAAA" />
    <SolidColorBrush x:Key="DataGridSortGlyphBrush" Color="#0056B3" />

    <sys:Double x:Key="CardShadowOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.1</sys:Double>

</ResourceDictionary>
