<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#F8F8F2" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#F8F8F2" />
    <!-- Foreground color for disabled/read-only controls -->
    <SolidColorBrush x:Key="ControlDisabledForegroundBrush" Color="#BFC7CD" />
    <!-- Scrollbar thumb colors -->
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#6F6F6F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#555555" />
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#404040" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#007BFF" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#007BFF" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#ADB5BD" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#28A745" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC3545" />
    <SolidColorBrush x:Key="WarningBrush" Color="#CF9C06" />
    <SolidColorBrush x:Key="InfoBrush" Color="#17A2B8" />
    <SolidColorBrush x:Key="LinkBrush" Color="#4DA6FF" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#F8F8F2" />
    <SolidColorBrush x:Key="MenuHighlightBrush" Color="#3E3E42" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#555555" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#000000" Opacity="0.3" />
    <SolidColorBrush x:Key="DataGridHeaderRowBackgroundBrush" Color="#424242" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="#343438" />
    <SolidColorBrush x:Key="DataGridRowHoverBackgroundBrush" Color="#24374D" />
    <SolidColorBrush x:Key="DataGridSortGlyphBrush" Color="#7DB6FF" />

    <sys:Double x:Key="CardShadowOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.3</sys:Double>

</ResourceDictionary>
