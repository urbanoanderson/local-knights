<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral palette -->
    <Color x:Key="CanvasColor">#0E111B</Color>
    <Color x:Key="SurfaceColor">#161A28</Color>
    <Color x:Key="SurfaceRaisedColor">#1D2339</Color>
    <Color x:Key="SurfaceHoverColor">#2C3142</Color>
    <Color x:Key="BorderColor">#343A4F</Color>
    <Color x:Key="TextPrimaryColor">#F8F8F2</Color>
    <Color x:Key="TextMutedColor">#BFC7CD</Color>

    <!-- Semantic neutrals -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ControlHighlightBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="ControlDisabledForegroundBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />

    <!-- Actions and status -->
    <SolidColorBrush x:Key="ActionForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0056B3" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#007BFF" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#004085" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SecondaryPressedBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#218838" />
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#28A745" />
    <SolidColorBrush x:Key="SuccessPressedBrush" Color="#1E7E34" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C82333" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC3545" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#BD2130" />
    <SolidColorBrush x:Key="WarningBrush" Color="#CF9C06" />
    <SolidColorBrush x:Key="WarningHoverBrush" Color="#E8B006" />
    <SolidColorBrush x:Key="WarningPressedBrush" Color="#AB8204" />
    <SolidColorBrush x:Key="InfoBrush" Color="#17A2B8" />
    <SolidColorBrush x:Key="LinkBrush" Color="#4DA6FF" />

    <!-- Table aliases -->
    <SolidColorBrush x:Key="DataGridHeaderRowBackgroundBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="DataGridRowHoverBackgroundBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="DataGridSelectedRowBackgroundBrush" Color="#0056B3" />
    <SolidColorBrush x:Key="DataGridSelectedRowForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridSortGlyphBrush" Color="#4DA6FF" />

    <sys:Double x:Key="CardShadowOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.3</sys:Double>

</ResourceDictionary>
